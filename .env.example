# ==============================================================================
# OIL Safety Intelligence Platform — Environment Configuration Template
# Problem Statement: SIH26165 (Oil India Limited)
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=true
APP_NAME="OIL Safety Intelligence Platform"
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000

# --- Database Configuration (PostgreSQL 16) ---
POSTGRES_USER=oil_admin
POSTGRES_PASSWORD=oil_secure_password_dev_only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=oil_safety_db
DATABASE_URL=postgresql://oil_admin:oil_secure_password_dev_only@postgres:5432/oil_safety_db

# --- Security Configuration ---
# Generate with: openssl rand -hex 32
SECRET_KEY=dev_secret_key_change_in_production_f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- ML & Model Cache Configuration ---
MODEL_CACHE_DIR=/app/models/cache
SPACY_MODEL_NAME=en_core_web_sm
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# --- Frontend Configuration (Local Vite Dev Server) ---
VITE_API_BASE_URL=http://localhost:8000
